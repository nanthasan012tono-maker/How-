-- ฟังก์ชันอัปเดตข้อความรายชื่อเพื่อนบนหน้าจอ
local function updateFriendDisplay()
    if #whitelistedFriends == 0 then
        friendListLabel.Text = "รายชื่อที่ยกเว้น (ยังไม่มี):"
    else
        friendListLabel.Text = "รายชื่อที่ยกเว้น:\n- " .. table.concat(whitelistedFriends, "\n- ")
    end
end

-- กดปุ่มเพิ่มชื่อเพื่อน
addFriendBtn.MouseButton1Click:Connect(function()
    local nameToAdd = friendInputBox.Text
    if nameToAdd ~= "" then
        -- เช็คว่ามีชื่อนี้ในตารางหรือยัง
        local found = false
        for _, name in ipairs(whitelistedFriends) do
            if name == nameToAdd then
                found = true
                break
            end
        end
        
        if not found then
            table.insert(whitelistedFriends, nameToAdd)
            updateFriendDisplay()
            friendInputBox.Text = ""
            friendInputBox.PlaceholderText = "เพิ่มสำเร็จ! ใส่ชื่อถัดไป..."
        else
            friendInputBox.Text = ""
            friendInputBox.PlaceholderText = "มีชื่อนี้อยู่แล้ว!"
        end
    end
end)

-- ตัวแปรการทำงานระบบดูดของ
local magnetEnabled = false
local magnetConnection

magnetToggle.MouseButton1Click:Connect(function()
    magnetEnabled = not magnetEnabled
    if magnetEnabled then
        magnetToggle.Text = "ระบบดูดของ: เปิด ✅"
        magnetToggle.TextColor3 = Color3.fromRGB(100, 255, 100)
        magnetToggle.BackgroundColor3 = Color3.fromRGB(60, 40, 90)
        
        -- ลูปทำงานดูดของทุกๆ เฟรม
        magnetConnection = runService.RenderStepped:Connect(function()
            local character = localPlayer.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then return end
            local rootPart = character.HumanoidRootPart
            
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("TouchTransmitter") and obj.Parent and obj.Parent:IsA("BasePart") then
                    if (obj.Parent.Position - rootPart.Position).Magnitude <= 50 then
                        obj.Parent.CFrame = rootPart.CFrame
                    end
                end
            end
        end)
    else
        magnetToggle.Text = "ระบบดูดของ: ปิด ❌"
        magnetToggle.TextColor3 = Color3.fromRGB(255, 100, 100)
        magnetToggle.BackgroundColor3 = Color3.fromRGB(40, 35, 55)
        
        if magnetConnection then
            magnetConnection:Disconnect()
            magnetConnection = nil
        end
    end
end)

