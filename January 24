-- ---------------------------------------------------------
-- ระบบลูปการทำงาน "ดูดของระยะไกล" (Distance Item Magnet Loop)
-- ---------------------------------------------------------
runService.RenderStepped:Connect(function()
    if not itemMagnetEnabled then return end
    
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = character.HumanoidRootPart
    
    -- ค้นหาไอเทมหรือชิ้นส่วนทั้งหมดใน Workspace
    for _, obj in ipairs(workspace:GetChildren()) do
        -- เช็คว่าเป็น Tool หรือมี Handle ที่สามารถดึงได้
        local targetPart = nil
        if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
            targetPart = obj.Handle
        elseif obj:IsA("Model") and obj:FindFirstChild("PrimaryPart") then
            targetPart = obj.PrimaryPart
        elseif obj:IsA("BasePart") then
            targetPart = obj
        end
        
        if targetPart then
            local distance = (targetPart.Position - rootPart.Position).Magnitude
            -- ถ้าระยะห่างน้อยกว่าระยะที่กำหนด (เช่น อยู่ในรัศมี 50 Studs) จะดึงเข้ามาหาตัว
            if distance <= magnetDistance and distance > 2 then
                targetPart.CFrame = rootPart.CFrame
                if targetPart:IsA("BasePart") then
                    targetPart.Velocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end
end)
